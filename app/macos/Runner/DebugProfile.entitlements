<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- NOTE: the multicast entitlement (com.apple.developer.networking.multicast)
	     is intentionally NOT in this Debug file. It requires a development
	     certificate / provisioning profile with that capability, so an
	     unsigned `flutter run` fails with: "Runner has entitlements that
	     require signing with a development certificate." Debug builds
	     therefore skip mDNS discovery on macOS — use "Add by IP" (manual
	     IP + port 48150) to pair; pairing itself does not need mDNS.
	     Release.entitlements keeps multicast for signed release builds. -->
</dict>
</plist>
